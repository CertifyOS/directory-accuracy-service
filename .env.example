# Copy to .env for local runs. Every ${...} application.properties reads is listed here.
# Values marked (required) have no default: the service refuses to boot without them.

PORT=8080
SHUTDOWN_TIMEOUT=30
SHUTDOWN_DELAY=10

# Role: exactly one of api | worker (RoleProfileCheck refuses otherwise)
QUARKUS_PROFILE=dev,api

# MongoDB (required). Transactions need a replica set, even locally:
#   docker run -d --name mongo -p 27017:27017 mongo:7.0 --replSet rs0
#   docker exec mongo mongosh --quiet --eval 'rs.initiate()'
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0

# Auth0 (only read when the OIDC tenant is on, i.e. the prod profile). Internal environment values:
AUTH0_ISSUER=https://auth-stg.certifyos.com/
AUTH0_AUDIENCE=https://ng-api-stg.certifyos.com/

# DAL (required). The IAP client id is the backend's OAuth client:
#   gcloud compute backend-services describe dal-service-internal --global --format='value(iap.oauth2ClientId)'
DAL_URL=https://dal.internal.certifyos.com
DAL_IAP_CLIENT_ID=

# Egress (required). Internal hostname from core-dal-egress-practitioner-async/infrastructure. The IAP
# client id is that backend's OAuth client; find the backend name first:
#   gcloud compute backend-services list --global --filter='name~egress' --format='value(name)'
#   gcloud compute backend-services describe <name> --global --format='value(iap.oauth2ClientId)'
EGRESS_URL=https://practitioner-egress-service.internal.certifyos.com
EGRESS_IAP_CLIENT_ID=
EGRESS_DEADLINE_HOURS=6
EGRESS_ABANDON_HOURS=48

# api-layer (URL required; client id and secret absent until the Auth0 machine client exists)
API_LAYER_URL=https://api-service.internal.certifyos.com
API_LAYER_CLIENT_ID=
API_LAYER_CLIENT_SECRET=
# api-service.internal is behind IAP with a Google-managed client; its audience is the backend service id
API_LAYER_IAP_AUDIENCE=/projects/106861691435/global/backendServices/7022850158602384579

# Vendor bucket (required): where egress copies the finished file and FinishJob verifies it
VENDOR_BUCKET=

# Ingestion (phase 2). The archive bucket is required; the rest are defaults the deployment may override
INGESTION_ARCHIVE_BUCKET=
INGESTION_DEADLINE_HOURS=6
STAGE_CHUNK_ROWS=500
REVIEW_PAGE_LIMIT_MAX=200
REJECTED_VALUE_TTL_MONTHS=12
RELEASE_READBACK_DEADLINE_MINUTES=30
RELEASE_BULK_MAX=5000
INBOUND_STALE_MINUTES=30
COMPLETENESS_SIGNAL=DATA_FILE

# file-ingestion (URL required; mapping id and IAP audience absent until they exist)
FILE_INGESTION_URL=
FILE_INGESTION_CONSUMER_IDENTIFIER=vendor-ingestion
FILE_INGESTION_MAPPING_ID=
FILE_INGESTION_IAP_AUDIENCE=

# Pub/Sub push (absent until the subscription exists; the push endpoint answers 401 meanwhile)
PUBSUB_PUSH_SERVICE_ACCOUNT=
PUBSUB_PUSH_AUDIENCE=

# Behaviour
DIRECTORY_ACCURACY_ENABLED=true
JOB_RETRIES=8
RECONCILER_STALE_MINUTES=30
PERMISSIONS_ENFORCE=false
AUTH_CACHE_TTL=PT5M
AUTH_CACHE_MAX_SIZE=1000

# Telemetry (all optional). OTel stays off until both are set; Sentry until enabled with a DSN.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=internal
