<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclusions for com.certifyos.directory_accuracy.

    One policy exclusion, taken from the new-service playbook: the expose-internal-representation
    rules are disabled once here rather than suppressed class by class (api-layer carries 614
    @SuppressFBWarnings for them). Records and DTOs here hold immutable Lists and Maps by convention
    (List.copyOf / Map.copyOf in compact constructors), which these two rules cannot see.

    Every other exclusion must name one class and one pattern and say why the finding is wrong there.
-->
<FindBugsFilter>
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>
    <!--
        The arrival handler refuses a completeness signal it does not implement in its constructor, so
        a misconfigured deployment fails at boot (the bean is @Startup). The finalizer attack this rule
        guards against needs a subclass with a finalizer constructed by untrusted code; Arc alone
        constructs this bean.
    -->
    <Match>
        <Class name="com.certifyos.directory_accuracy.ingestion.events.ArrivalHandler"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
